# Copy this file to ".env" and fill in your own values. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string

# Supabase > Connect > Session pooler (port 5432). Leave empty to use local SQLite.
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR-DB-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Supabase > Project Settings > API. Leave empty to save files in local uploads/ folder.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_BUCKET=uploads
